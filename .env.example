# Copy to .env and adjust. Every variable is optional; defaults are in rag/common/config.py.
CORPUS_DIR=./corpus
INDEX_VERSION=v1
MODEL_BACKEND=real
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# LLM endpoint (OpenAI-compatible chat completions). Needed for real answers from M3 on.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SMALL_MODEL=

PG_DSN=postgresql://rag:rag@127.0.0.1:5432/rag
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6333
OPENSEARCH_URL=http://127.0.0.1:9200
