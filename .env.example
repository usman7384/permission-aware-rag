# Copy to .env and adjust. Every variable is optional; defaults are in rag/common/config.py.
CORPUS_DIR=./corpus
INDEX_VERSION=v1
MODEL_BACKEND=real
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# LLM endpoint (OpenAI-compatible chat completions; LLM_BASE_URL ends before /chat/completions,
# for example https://api.openai.com/v1). Needed for real answers from M3 on.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SMALL_MODEL=
# LLM_TIMEOUT_S=30
# ANSWER_MAX_TOKENS=1024
# REWRITE_MAX_TOKENS=256
# HISTORY_TURNS=4
# JUDGE_MAX_TOKENS=4

# Inference service (make inference); unset INFERENCE_URL runs the models in this process
# INFERENCE_URL=http://127.0.0.1:8100
# INFERENCE_TIMEOUT_MS=10000    # client timeout for /embed (/rerank uses RERANK_TIMEOUT_MS)
# INFERENCE_CONCURRENCY=2       # service side: model calls at once
# INFERENCE_QUEUE_MAX=8         # service side: calls waiting for a slot; more get 503

# Timeouts and fault injection (POST /admin/faults)
# RETRIEVE_TIMEOUT_MS=500
# RERANK_TIMEOUT_MS=2000
# FAULT_SLOW_MS=5000

# Guardrails and rate limit
# MAX_QUESTION_CHARS=2000
# RATE_LIMIT_PER_MIN=60
# RATE_LIMIT_TTL_S=120

# Retrieval and caches
# EXACT_SCAN_MAX_CHUNKS=2000    # dense search scans exactly when the user can read this few chunks
# SEMANTIC_CACHE_THRESHOLD=0.98

PG_DSN=postgresql://rag:rag@127.0.0.1:5432/rag
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6333
OPENSEARCH_URL=http://127.0.0.1:9200

# Ingestion worker
# MAX_DELIVERIES=3
# RECLAIM_IDLE_MS=30000
# WORKER_BLOCK_MS=2000
# OUTBOX_POLL_MS=200            # relay pause when the outbox is empty
# OUTBOX_BATCH=100              # events the relay publishes per transaction

# Contextual chunking (change INDEX_VERSION when switching it)
# CONTEXTUAL_CHUNKING=false
# CONTEXT_DOC_TOKENS=2000
# CONTEXT_MAX_TOKENS=128

# Qdrant chunk vectors (applied when a collection is created; change INDEX_VERSION to rebuild)
# QDRANT_QUANTIZATION=none      # none, int8 or binary
# QDRANT_VECTORS_ON_DISK=false  # keep the original vectors on disk, quantized ones in RAM
# DOWNLOAD_TIMEOUT_S=120        # benchmark download (make bench-load)
# INDEX_WAIT_TIMEOUT_S=600      # experiments: wait for Qdrant to finish optimizing a collection

